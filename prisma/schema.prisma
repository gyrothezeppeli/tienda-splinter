generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model Usuario {
    id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    email         String   @unique
    nombre        String?
    avatar        String?
    rol           String   @default("cliente")
    creadoEn      DateTime @default(now()) @map("creado_en")
    actualizadoEn DateTime @updatedAt @map("actualizado_en")

    pedidos   Pedido[]
    favoritos Favorito[]
    resenas   Resena[]
    carritos  Carrito[]

    @@map("usuarios")
}

model Producto {
    id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name             String
    category         String
    price            Float
    originalPrice    Float?
    status           String   @default("Nuevo")
    label            String?
    badge            String?
    image            String?
    imagePath        String?
    fallbackIcon     String   @default("📦")
    stock            Int      @default(0)
    description      String?
    especificaciones Json?
    createdAt        DateTime @default(now()) @map("creado_en")
    updatedAt        DateTime @updatedAt @map("actualizado_en")

    detallesPedido DetallePedido[]
    favoritos      Favorito[]
    resenas        Resena[]
    imagenes       ImagenProducto[]
    carritoItems   CarritoItem[]

    categoria   Categoria? @relation(fields: [categoriaId], references: [id])
    categoriaId String?    @map("categoria_id") @db.Uuid
    marca       Marca?     @relation(fields: [marcaId], references: [id])
    marcaId     String?    @map("marca_id") @db.Uuid

    @@map("productos")
}

model ImagenProducto {
    id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    productoId  String   @map("producto_id") @db.Uuid
    url         String
    path        String
    esPrincipal Boolean  @default(false) @map("es_principal")
    orden       Int      @default(0)
    createdAt   DateTime @default(now()) @map("creado_en")

    producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

    @@map("imagenes_producto")
}

model Categoria {
    id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    nombre      String   @unique
    descripcion String?
    slug        String   @unique
    icono       String?
    imagen      String?
    orden       Int      @default(0)
    createdAt   DateTime @default(now()) @map("creado_en")
    updatedAt   DateTime @updatedAt @map("actualizado_en")

    productos Producto[]

    @@map("categorias")
}

model Pedido {
    id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    usuarioId    String    @map("usuario_id") @db.Uuid
    total        Float
    subtotal     Float
    impuestos    Float     @default(0)
    envio        Float     @default(0)
    estado       String    @default("pendiente")
    fechaPedido  DateTime  @default(now()) @map("fecha_pedido")
    fechaEnvio   DateTime? @map("fecha_envio")
    fechaEntrega DateTime? @map("fecha_entrega")
    direccion    String
    ciudad       String
    codigoPostal String    @map("codigo_postal")
    telefono     String
    notas        String?
    metodoPago   String    @default("efectivo")
    createdAt    DateTime  @default(now()) @map("creado_en")
    updatedAt    DateTime  @updatedAt @map("actualizado_en")

    usuario  Usuario         @relation(fields: [usuarioId], references: [id])
    detalles DetallePedido[]

    @@map("pedidos")
}

model DetallePedido {
    id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    pedidoId       String   @map("pedido_id") @db.Uuid
    productoId     String   @map("producto_id") @db.Uuid
    cantidad       Int
    precioUnitario Float    @map("precio_unitario")
    descuento      Float    @default(0)
    subtotal       Float
    createdAt      DateTime @default(now()) @map("creado_en")

    pedido   Pedido   @relation(fields: [pedidoId], references: [id])
    producto Producto @relation(fields: [productoId], references: [id])

    @@map("detalles_pedido")
}

model Favorito {
    id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    usuarioId  String   @map("usuario_id") @db.Uuid
    productoId String   @map("producto_id") @db.Uuid
    createdAt  DateTime @default(now()) @map("creado_en")

    usuario  Usuario  @relation(fields: [usuarioId], references: [id])
    producto Producto @relation(fields: [productoId], references: [id])

    @@unique([usuarioId, productoId])
    @@map("favoritos")
}

model Resena {
    id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    usuarioId    String   @map("usuario_id") @db.Uuid
    productoId   String   @map("producto_id") @db.Uuid
    calificacion Int      @default(5)
    titulo       String?
    comentario   String?
    aprobado     Boolean  @default(false)
    createdAt    DateTime @default(now()) @map("creado_en")
    updatedAt    DateTime @updatedAt @map("actualizado_en")

    usuario  Usuario  @relation(fields: [usuarioId], references: [id])
    producto Producto @relation(fields: [productoId], references: [id])

    @@map("resenas")
}

model Carrito {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    usuarioId String?  @map("usuario_id") @db.Uuid
    sesionId  String?  @map("sesion_id")
    createdAt DateTime @default(now()) @map("creado_en")
    updatedAt DateTime @updatedAt @map("actualizado_en")

    usuario Usuario?      @relation(fields: [usuarioId], references: [id])
    items   CarritoItem[]

    @@map("carritos")
}

model CarritoItem {
    id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    carritoId  String   @map("carrito_id") @db.Uuid
    productoId String   @map("producto_id") @db.Uuid
    cantidad   Int      @default(1)
    createdAt  DateTime @default(now()) @map("creado_en")
    updatedAt  DateTime @updatedAt @map("actualizado_en")

    carrito  Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
    producto Producto @relation(fields: [productoId], references: [id])

    @@map("carrito_items")
}

model Marca {
    id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    nombre      String   @unique
    descripcion String?
    logo        String?
    sitioWeb    String?
    createdAt   DateTime @default(now()) @map("creado_en")
    updatedAt   DateTime @updatedAt @map("actualizado_en")

    productos Producto[]

    @@map("marcas")
}
